# MongoDB (dev database — separate from production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.nd366ml.mongodb.net/
MONGODB_DB_NAME=find-near-doctor-dev

# Auth
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Platform Admin

# SMS — MSG91 OTP Widget (recommended) or legacy template API
SMS_DEV_MODE=false
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_AUTH_TOKEN=
MSG91_TEMPLATE_ID=

# Files — Cloudinary (https://cloudinary.com) — active
# UPLOAD_DEV_MODE=true only if Cloudinary keys are missing (base64 fallback)
# Or set CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
UPLOAD_DEV_MODE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
